Output ./docs/assets/alias.gif

Set Shell "zsh"
Set FontSize 16
Set Width 1000
Set Height 560
Set TypingSpeed 60ms
Set Padding 20

Env XDG_CONFIG_HOME "docs/tapes/config"

Type "cat $XDG_CONFIG_HOME/eta/config"
Sleep 0.3s
Enter
Sleep 2s

Type "eta"
Sleep 0.3s
Enter
Sleep 3s

Type "eta bergen 1 byparken"
Sleep 0.3s
Enter
Sleep 4s

Type "eta work -c 2"
Sleep 0.3s
Enter
Sleep 5s

