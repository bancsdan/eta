Output ./docs/assets/alias.gif

Set Shell "zsh"
Set FontSize 16
Set Width 1200
Set Height 520
Set TypingSpeed 80ms
Set Padding 20

Env XDG_CONFIG_HOME "docs/tapes/config"

Type "cat $XDG_CONFIG_HOME/eta/config"
Sleep 0.3s
Enter
Sleep 2s
Type "eta"
Sleep 0.3s
Enter
Sleep 3s
Type "eta work -c 2"
Sleep 0.3s
Enter
Sleep 5s
